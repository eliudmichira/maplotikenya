rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    // Read is public so visitors can view agent/landlord contact details on
    // listings (the core browsing flow). Writes are strictly self-only.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }

    // Listings collection
    // Read is public. Anyone signed in can create a listing; only the
    // listing's owner (or an admin) can update or delete it. Anyone may
    // bump the read-only `views` counter (the detail screen does this for
    // every visitor, signed in or not).
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.ownerId) || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // Testimonials collection
    // Shown on the home page to every visitor, so read is public. The review
    // form on the home page is open to visitors as well, so create is
    // allowed for anyone but the payload shape is validated. Editing or
    // removing a review is admin-only.
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'comment', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000;
      allow update, delete: if isAdmin();
    }
  }
}
