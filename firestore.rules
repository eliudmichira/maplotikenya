rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    // Read is public so visitors can view agent/landlord contact details on
    // listings (the core browsing flow). Writes are strictly self-only.
    match /users/{userId} {
      allow read: if true;
      // A user creates their own profile but can never grant themselves the
      // admin role. Admins are promoted from the admin panel.
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'user') != 'admin';
      // Owners edit their own profile without touching `role`; admins can
      // edit or remove any account (role changes, suspensions).
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isOwner(userId) || isAdmin();

      // Private per-user data: favorites, notifications, push tokens.
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Listings collection
    // Read is public. Anyone signed in can create a listing; only the
    // listing's owner (or an admin) can update or delete it. Anyone may
    // bump the read-only `views` counter (the detail screen does this for
    // every visitor, signed in or not).
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.ownerId) || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);

      // Reviews on a listing: public to read, signed-in users may post one.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // Testimonials collection
    // Shown on the home page to every visitor, so read is public. The review
    // form on the home page is open to visitors as well, so create is
    // allowed for anyone but the payload shape is validated. Editing or
    // removing a review is admin-only.
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'comment', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // Public content, admin-managed
    // An agent's profile lives at agents/{uid}. The user may create and
    // update their own profile (this is how the verification request form
    // works) but can never mark themselves verified; only admins can.
    match /agents/{agentId} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (isOwner(agentId) && request.resource.data.verified != true);
      allow delete: if isAdmin();
    }
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Conversations are private to their participants; messages inherit.
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if isAdmin();
      }
    }

    // Bookings belong to the tenant who made them and the agent they target.
    match /bookings/{bookingId} {
      allow read, update: if isSignedIn()
        && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.agentId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow delete: if isAdmin();
    }

    // Inquiries: signed-in users send them; the target agent reads them.
    match /inquiries/{inquiryId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.agentId || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Intake and analytics written by signed-in users, read by admins only.
    match /trialSignups/{signupId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    match /emailQueue/{emailId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    match /analytics/{eventId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Page view counters: signed-in users bump them; totals are public.
    match /pageViews/{viewId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Admin settings
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
